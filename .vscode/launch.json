    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMD shop amazon",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "shop",
                "--force",
                "Amazon"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py"
        },
        {
            "name": "Python Debugger: Django",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py"
        }
    ]
}
